# Settings for `just eval`. Copy this file to .env and fill it in. .env is gitignored.

# The API key of the provider of EVAL_MODEL, under the name that pi reads.
# See `docs/providers.md` of pi. Examples: OPENCODE_API_KEY (opencode, opencode-go),
# OPENROUTER_API_KEY (openrouter).
OPENCODE_API_KEY=

# The model of the agent under test, as <provider>/<model id>. Use a pinned snapshot,
# so that runs stay comparable. List the models with `pi-bolt --list-models <provider>`
# after you set the key.
EVAL_MODEL=

# The model that answers the judge checks. Empty means EVAL_MODEL.
EVAL_JUDGE_MODEL=

# The pi binary. Empty means pi-bolt.
PI_BIN=
